# 环境变量模板。这个文件跟着仓库走，只放空值和示例值。
#
#   cp .env.example .env
#   chmod 600 .env
#   vi .env
#
# .env 已在 .gitignore 里，不会被提交。
#
# 规则：变量名一律不要加 VITE_ 前缀。vite 的 envPrefix 默认是 VITE_，
# 带这个前缀的值会被编译进浏览器能下载到的 JS 里，等于公开密钥。
# 已存在的环境变量优先于本文件，临时覆盖用 `PORT=10060 npm run dev`。

# ── 腾讯云 MPS SmartErase 凭证 ────────────────────────────────────────────
# 控制台 → 访问管理 → API 密钥管理。建议用子账号，只授予 MPS + 目标 COS 桶权限。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# SmartErase 产出写入的 COS 桶和它所在地域。桶必须属于上面这对密钥的账号。
TENCENT_COS_BUCKET=jogg-superres-1305113514
TENCENT_COS_REGION=na-ashburn

# 提交任务的 MPS 地域，以及智能擦除模板 ID。
#
# TENCENT_DEFINITION 是你账号下的「智能擦除」模板 ID，不是固定常量。
# 腾讯云在 2025 年 9 月之后的新版里，模板由 CreateSmartEraseTemplate 创建，
# EraseType 有三种：subtitle(去字幕) / watermark(去水印) / privacy(隐私保护)。
# 101 是去字幕模板。实测行为：只擦画面中下部的字幕区域，顶部横幅、
# 角标 Logo 不在它的检测范围内——想去水印需要另建一个 watermark 模板。
TENCENT_MPS_REGION=ap-guangzhou
TENCENT_DEFINITION=101

# 调用 tencent_smart_erase.py 的解释器。
TENCENT_PYTHON=python3

# ── 源视频对外地址 ────────────────────────────────────────────────────────
# 腾讯云 MPS 会从公网 GET 这个地址取源视频，所以它必须是外网可达的 https 域名，
# 不能是 127.0.0.1，也不能挡在 Basic Auth 后面。
# 留空时后端用 http://127.0.0.1:<PORT>，只够本机跑通上传和播放，提交到腾讯会失败。
SOURCE_PUBLIC_BASE=https://removetextfromvideo.io

# 浏览器侧用的地址前缀（结果播放/下载链接）。通常和上面相同，留空则用相对路径。
PUBLIC_BASE=

# ── 后端服务 ──────────────────────────────────────────────────────────────
# erase-api 独立模式监听的地址和端口（npm run preview / 生产用）。
# dev 模式下 api 挂在 vite 进程里，不用这两项。
#
# API_HOST 默认 127.0.0.1：生产是 nginx 在前面转发，后端自己没有 TLS，
# 不该直接暴露在公网。真要裸跑才改成 0.0.0.0，并且把 TRUST_PROXY 关掉。
API_HOST=127.0.0.1
API_PORT=10060

# 数据目录：源视频、结果视频、任务状态、用户账号都放这里。
DATA_DIR=./data

# ── Google 登录（可选）────────────────────────────────────────────────────
# 留空时只关闭 Google 登录；邮箱密码登录和匿名使用仍可用。
#
# 开启步骤（在 Google Cloud Console 做，和部署机器无关）：
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins 填**线上实际域名**，必须精确匹配，
#      带端口的话端口也要写：
#        https://removetextfromvideo.io
#      本地调试再加一条 http://127.0.0.1:5173（localhost 和 127.0.0.1
#      在这里算两个不同的来源，用哪个就填哪个）。
#   4. 不需要填 Authorized redirect URIs —— 这里用的是 Google Identity
#      Services 的 ID token 流程，不走重定向。
#   5. 把 Client ID 填到下面。Client secret 用不上，不要放进这个文件。
#
# Client ID 是公开信息，会出现在前端发给 Google 的请求里，不是密钥。
GOOGLE_CLIENT_ID=

# 会话 cookie 的签名密钥（至少 32 字符）。
#
# 留空时后端会在 DATA_DIR 下生成 session-secret 并一直用它，单机部署不用管。
# **多台机器**或容器化部署必须显式设置同一个值，否则每台机器签出来的会话
# 别的机器不认，用户会随着负载均衡被反复踢下线。
# 换掉这个值等于把所有人登出。
#   openssl rand -hex 32
SESSION_SECRET=

# 会话 cookie 要不要带 Secure（只走 HTTPS）。
# 留空时按 PUBLIC_BASE / SOURCE_PUBLIC_BASE 是不是 https 自动判断。
# 生产必须是 true；本地 http 调试必须是 false，否则浏览器会直接丢掉这个
# cookie，表现是"点了登录、也没报错，但就是没登上"。
COOKIE_SECURE=

# 登录用户的任务**记录**保留多久（毫秒），默认 30 天。
# 视频文件仍然按 RETENTION_MS 删（24 小时），这里留下的只是文件名、时长、
# 状态这些元数据，好让人隔几天回来还看得到自己处理过什么。
# 匿名任务不适用：它们没有归属，记录跟文件一起清掉。
# 必须 >= RETENTION_MS。
RECORD_RETENTION_MS=2592000000

# 单个文件上传上限（字节），默认 600MB。
MAX_UPLOAD_BYTES=629145600

# 源视频最长时长（秒），默认 15 分钟。需要 ffprobe 才会生效。
MAX_DURATION_SECONDS=900

# 文件保留时长（毫秒），超过就删掉源视频和结果，默认 24 小时。
RETENTION_MS=86400000

# 同一 IP 的并发任务数和 24 小时内任务上限，用来挡滥用。
# 登录用户按账号算，匿名访客按 IP 算——额度一样，只是算得更准：
# 同一个 NAT 后面的人不会再互相挤占。
RATE_LIMIT_CONCURRENT=2
RATE_LIMIT_DAILY=10

# 站在 nginx/caddy 后面时设为 true，后端才会认 X-Forwarded-For 里的来源 IP。
# 直接把 API_PORT 暴露在公网时必须保持 false：否则任何人伪造一个请求头
# 就能绕开上面两条限流。
TRUST_PROXY=false

# 轮询腾讯任务状态的间隔（毫秒）与单个任务的超时时间（毫秒）。
POLL_INTERVAL_MS=5000
JOB_TIMEOUT_MS=3600000
# Experimental Waffo test mode only. Keep false until the integration and
# subscription lifecycle have been fully verified. Never use real card details.
BILLING_ENABLED=false
# Experimental sandbox subscriptions; enable only after webhook testing.
BILLING_TEST_SUBSCRIPTIONS_ENABLED=false
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
# Server-side test API private key. Keep it out of git and never expose it to browsers.
# Use a single-line base64 key or a PEM value with literal \n line breaks.
WAFFO_PRIVATE_KEY=
# Optional alternative: PEM file readable by the erase service user.
WAFFO_PRIVATE_KEY_FILE=
# Optional: override Waffo's built-in test webhook verification public key.
WAFFO_WEBHOOK_PUBLIC_KEY_FILE=
